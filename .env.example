# Desarrollo local. Usa un valor aleatorio distinto para cada entorno real.
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Solo si el frontend se sirve desde otro origen; no usar *.
DJANGO_CORS_ALLOWED_ORIGINS=
# Orígenes completos (https://host) que pueden enviar POST de sesión/admin.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Producción: true por defecto cuando DJANGO_DEBUG=false. Habilítalo solo tras
# confirmar que el proxy confiable sobrescribe X-Forwarded-Proto.
DJANGO_SECURE_PROXY_SSL_HEADER=false
# Producción: 31536000 por defecto. Mantener 0 únicamente en desarrollo.
DJANGO_SECURE_HSTS_SECONDS=31536000
# Activar solo después de verificar que todos los subdominios usan HTTPS.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false

# PostgreSQL (opcional para desarrollo local)
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
